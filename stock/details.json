[{"id":101,"note":"1000번 바디·로터에 2000번 대구경 스풀을 얹은 모델로, 라이트솔트·에어리어 트라우트용 정석 모델이라고 소개돼요.","specs":[["기어비","5.1"],["무게","180g"],["최대 드래그","3.0kg"],["권사량","PE 0.6호-150m, 0.8호-110m, 1호-80m"],["핸들 1회전","69cm"],["베어링","9/1"]],"src":"https://web.archive.org/web/20210123182538/http://fishing.shimano.co.jp/product/reel/5913","src_label":"시마노 공식 페이지(2021년 보관본)"},{"id":102,"note":"C2000 계열 기본 모델로, 1000번 바디에 2000번 대구경 스풀을 얹었어요. 라이트솔트·에어리어 트라우트 입문용으로 소개돼요.","specs":[["기어비","5.1"],["무게","150g"],["최대 드래그","3.0kg"],["권사량","PE 0.6호-150m, 0.8호-110m, 1호-80m"],["핸들 1회전","69cm"],["베어링","7/1"]],"src":"https://web.archive.org/web/20210417195714/http://fishing.shimano.co.jp/product/reel/6165","src_label":"시마노 공식 페이지(2021년 보관본)"},{"id":103,"note":"에깅 스탠더드 모델로, 에깅 낚시인들의 요청에 맞춰 노멀 기어비와 더블 핸들을 기본으로 달았어요.","specs":[["기어비","5.3"],["무게","180g"],["최대 드래그","9.0kg"],["권사량","PE 0.6호-200m, 0.8호-150m, 1호-120m"],["핸들 1회전","78cm"],["베어링","9/1"]],"src":"https://web.archive.org/web/20210417195714/http://fishing.shimano.co.jp/product/reel/6165","src_label":"시마노 공식 페이지(2021년 보관본)"},{"id":104,"note":"세피아 SS는 코어프로텍트로 방수성을 높이고 G프리 바디로 로드와의 일체감을 높여 샤쿠리·스테이를 돕는 시리즈예요. DH는 더블 핸들 사양이에요.","specs":[["기어비","5.0"],["무게","220g"],["최대 드래그","9.0kg"],["권사량","PE 0.6호-200m, 0.8호-150m, 1호-110m"],["핸들 1회전","73cm"],["베어링","7/1"]],"src":"https://web.archive.org/web/20200811101632/http://fishing.shimano.co.jp/product/reel/5833","src_label":"시마노 공식 페이지(2020년 보관본)"},{"id":105,"note":"세피아 SS는 코어프로텍트로 방수성을 높이고 G프리 바디로 로드와의 일체감을 높여 샤쿠리·스테이를 돕는 시리즈예요. DH는 더블 핸들, HG는 하이기어 사양이에요.","specs":[["기어비","6.0"],["무게","220g"],["최대 드래그","9.0kg"],["권사량","PE 0.6호-200m, 0.8호-150m, 1호-110m"],["핸들 1회전","88cm"],["베어링","7/1"]],"src":"https://web.archive.org/web/20200811101632/http://fishing.shimano.co.jp/product/reel/5833","src_label":"시마노 공식 페이지(2020년 보관본)"},{"id":106,"note":"에깅 전용 릴로, 연속 저크를 견디는 내구성과 가벼움, 감을 때의 정숙성을 추구했다고 소개돼요.","specs":[["기어비","5.3"],["무게","185g"],["최대 드래그","9kg"],["권사량","PE 0.6호-200m, 0.8호-150m, 1호-120m"],["핸들 1회전","78cm"],["베어링","9/1"]],"src":"https://web.archive.org/web/20211025103136/https://fish.shimano.com/ja-JP/product/reel/hanyouspinning/a075f00003t4cxpqa3.html","src_label":"시마노 공식 페이지(2021년 보관본)"},{"id":107,"note":"카운터 달린 경량 타이라바 릴에 폴 레버를 더해 폴 속도를 조절하고, 디지털 카운터에 폴·감기 속도를 숫자로 보여줘요.","specs":[["기어비","5.8"],["무게","250g"],["최대 드래그","6.0kg"],["권사량","PE 0.8호-400m, 1호-330m, 1.5호-200m"],["핸들 1회전","58cm"],["베어링","5/1"]],"src":"https://web.archive.org/web/20190204002156/http://fishing.shimano.co.jp/product/reel/5568","src_label":"시마노 공식 페이지(2019년 보관본)"},{"id":108,"note":"폴 레버를 단 타이라바 릴로, 카운터에 수심과 폴·감기 속도를 표시해요. 큰 참돔 공략부터 메탈스테 게임까지 권한다고 소개돼요.","specs":[["기어비","7.8"],["무게","250g"],["최대 드래그","5.0kg"],["권사량","PE 0.8호-400m, 1호-330m, 1.5호-200m"],["핸들 1회전","78cm"],["베어링","8/1"]],"src":"https://web.archive.org/web/20171227112052/http://fishing.shimano.co.jp/product/reel/5234","src_label":"시마노 공식 페이지(2017년 보관본)"},{"id":109,"note":"오프쇼어용 장구 릴로는 처음 마이크로모듈 기어를 단 시리즈의 하이기어 모델로, 60mm 롱 크랭크 핸들을 달았어요.","specs":[["기어비","6.2"],["무게","285g"],["최대 드래그","5.0kg"],["권사량","PE 2호-200m, 1호-440m"],["핸들 1회전","78cm"],["베어링","10/1"]],"src":"https://web.archive.org/web/20150513022355/http://fishing.shimano.co.jp/product/reel/3699","src_label":"시마노 공식 페이지(2015년 보관본)"},{"id":110,"note":"2015년에 추가된 파워기어(PG) 모델로, 타이라바에서 중요한 등속 감기를 돕는다고 소개돼요.","specs":[["기어비","4.8"],["무게","275g"],["최대 드래그","6.0kg"],["권사량","PE 2호-200m, 1호-440m"],["핸들 1회전","60cm"],["베어링","12/1"]],"src":"https://web.archive.org/web/20150513022355/http://fishing.shimano.co.jp/product/reel/3699","src_label":"시마노 공식 페이지(2015년 보관본)"},{"id":111,"note":"범용성 높은 100번 크기의 파워기어(PG) 모델로, 폴 레버와 레벨와인드 연동 스풀을 단 타이라바 릴이에요.","specs":[["기어비","5.8"],["무게","205g"],["최대 드래그","4.5kg"],["권사량","PE 0.8호-250m, 1호-200m, 1.5호-130m"],["핸들 1회전","58cm"],["베어링","8/1"]],"src":"https://web.archive.org/web/20210311133833/http://fishing.shimano.co.jp/product/reel/6274","src_label":"시마노 공식 페이지(2021년 보관본)"},{"id":112,"note":"100번 크기 파워기어(PG)의 왼손 감기 모델(101번 표기)로, 폴 레버와 레벨와인드 연동 스풀을 단 타이라바 릴이에요.","specs":[["기어비","5.8"],["무게","205g"],["최대 드래그","4.5kg"],["권사량","PE 0.8호-250m, 1호-200m, 1.5호-130m"],["핸들 1회전","58cm"],["베어링","8/1"]],"src":"https://web.archive.org/web/20210311133833/http://fishing.shimano.co.jp/product/reel/6274","src_label":"시마노 공식 페이지(2021년 보관본)"},{"id":113,"note":"선상 소물 낚시용 릴로, 150/151은 쥐치·한치·가자미 등에 맞춰 핸들 노브를 키우고 55mm 더블 크랭크 핸들을 달았어요.","specs":[["기어비","6.3"],["무게","195g"],["최대 드래그","4.5kg"],["권사량","PE 1.5호-200m, 2호-150m, 3호-100m"],["핸들 1회전","67cm"],["베어링","3/1"]],"src":"https://web.archive.org/web/20200210061446/http://fishing.shimano.co.jp/product/reel/5916","src_label":"시마노 공식 페이지(2020년 보관본)"},{"id":114,"note":"선상 소물 낚시용 릴로, 150/151은 쥐치·한치·가자미 등에 맞춰 핸들 노브를 키우고 55mm 더블 크랭크 핸들을 달았어요.","specs":[["기어비","6.3"],["무게","195g"],["최대 드래그","4.5kg"],["권사량","PE 1.5호-200m, 2호-150m, 3호-100m"],["핸들 1회전","67cm"],["베어링","3/1"]],"src":"https://web.archive.org/web/20200210061446/http://fishing.shimano.co.jp/product/reel/5916","src_label":"시마노 공식 페이지(2020년 보관본)"},{"id":115,"note":"얕은 스풀과 하이리스폰스 드래그를 갖춘 라이트게임 모델로, C2000SSPG는 섬세하게 조작하는 표준 아징 릴로 소개돼요.","specs":[["기어비","4.6"],["무게","185g"],["최대 드래그","3kg"],["권사량","PE 0.6호-140m, 0.8호-100m, 1호-70m"],["핸들 1회전","62cm"],["베어링","5/1"]],"src":"https://web.archive.org/web/20230401180852/https://fish.shimano.com/ja-JP/product/reel/hanyouspinning/a075f00003u0gyoqai.html","src_label":"시마노 공식 페이지(2023년 보관본)"},{"id":116,"note":"파워와 스피드를 겸한 XG 중 나사식 핸들 사양이에요. SUT 브레이크 II가 없는 노멀 브레이크 타입이라 좌우 겸용이에요.","specs":[["기어비","6.6"],["무게","235g"],["최대 드래그","8kg"],["권사량","PE 1호-400m, 1.5호-270m, 2호-200m"],["핸들 1회전","98cm"],["베어링","8/0"]],"src":"https://web.archive.org/web/20221015085219/https://fish.shimano.com/ja-JP/product/reel/leverbrakespinning/a075f00003imnb1qag.html","src_label":"시마노 공식 페이지(2022년 보관본)"},{"id":117,"note":"라인 트러블을 줄이고 원투를 돕는 AR-C 스풀을 달았고, 민물·바다 어디서나 쓸 수 있는 넥서브 시리즈예요.","specs":[["기어비","5"],["무게","225g"],["최대 드래그","3kg"],["권사량","PE 0.6호-150m, 0.8호-110m, 1호-80m"],["핸들 1회전","66cm"],["베어링","3/1"]],"src":"https://web.archive.org/web/20210510222304/https://fish.shimano.com/ja-JP/product/reel/hanyouspinning/a071000000oysgkaav.html","src_label":"시마노 공식 페이지(2021년 보관본)"},{"id":118,"note":"스피닝 릴의 정점을 지향해 온 스텔라에 인피니티 크로스·인피니티 루프·인피니티 드라이브 세 기술을 담았다고 소개돼요.","specs":[["기어비","5.8"],["무게","220g"],["최대 드래그","9kg"],["권사량","PE 0.6호-200m, 0.8호-150m, 1호-120m"],["핸들 1회전","86cm"],["베어링","14/1"]],"src":"https://web.archive.org/web/20220121110318/https://fish.shimano.com/ja-JP/product/reel/hanyouspinning/a075f00003e22p2qaa.html","src_label":"시마노 공식 페이지(2022년 보관본)"},{"id":119,"note":"에깅은 물론 항만권 농어, 중규모 본류의 곤들매기·산천어 등 다양한 낚시에 쓰는 유틸리티 모델이라고 소개돼요.","specs":[["기어비","5.2"],["무게","180g"],["최대 드래그","10.0kg"],["권사량","PE 1.0호-200m, 1.2호-190m, 1.5호-170m"],["핸들 1회전","77cm"],["베어링","9/1"]],"src":"https://web.archive.org/web/20220918081353/https://www.daiwa.com/jp/fishing/item/reel/spin_rl/luvias20/index.html","src_label":"다이와 공식 페이지(2022년 보관본)"},{"id":120,"note":"2500번 클래스에서 155g으로 가벼운 피네스 커스텀 모델로, 라이트 리그 배스 낚시에 맞고 라이트솔트에도 두루 쓸 수 있어요.","specs":[["기어비","5.1"],["무게","155g"],["최대 드래그","5.0kg"],["권사량","PE 0.6호-200m, 0.8호-190m, 1.0호-140m"],["핸들 1회전","72cm"],["베어링","9/1"]],"src":"https://web.archive.org/web/20220918081353/https://www.daiwa.com/jp/fishing/item/reel/spin_rl/luvias20/index.html","src_label":"다이와 공식 페이지(2022년 보관본)"},{"id":201,"note":"에깅 표준 길이의 올라운더 솔리드 팁 모델이에요. 조작성·원투성·파워를 고루 갖췄고, 솔리드 팁이라 입질을 눈으로 확인하기 쉬워요.","specs":[["길이","2.59m (8'6\")"],["절수","2절"],["무게","108g"],["에기","2~4호"],["라인","PE 0.5~1호"]],"src":"https://web.archive.org/web/20220815215809/https://fish.shimano.com/ja-JP/product/rod/egisutte/eging/a075f00003e2h9qqaa.html","src_label":"시마노 공식 페이지(2022년 보관본)"},{"id":202,"note":"에깅 표준 길이의 올라운더로, 필드나 시즌을 가리지 않고 쓰는 모델이에요. 딥 타입 에기도 확실히 캐스팅할 수 있는 파워를 지녔다고 소개돼요.","specs":[["길이","2.59m (8'6\")"],["절수","2절"],["무게","110g"],["에기","2~4호"],["라인","PE 0.5~1호"]],"src":"https://web.archive.org/web/20220815215809/https://fish.shimano.com/ja-JP/product/rod/egisutte/eging/a075f00003e2h9qqaa.html","src_label":"시마노 공식 페이지(2022년 보관본)"},{"id":203,"note":"섬세함을 중시한 모델로, 다루기 쉽고 경쾌한 6'6\" 길이예요. 팁은 부드럽고 섬세하게 휘는 솔리드 '터프텍α'예요.","specs":[["길이","1.98m (6'6\")"],["절수","2절"],["무게","85g"],["에기","MAX60g"],["라인","PE 0.4~1호"]],"src":"https://web.archive.org/web/20180621123605/http://fishing.shimano.co.jp:80/product/rod/5370","src_label":"시마노 공식 페이지(2018년 보관본)"},{"id":204,"note":"빠르고 적극적인 유인에 맞춘 모델로, 다루기 쉽고 경쾌한 6'6\" 길이예요. 팁은 터프텍α보다 탄력이 있는 솔리드 '터프텍'이에요.","specs":[["길이","1.98m (6'6\")"],["절수","2절"],["무게","88g"],["에기","MAX80g"],["라인","PE 0.4~1호"]],"src":"https://web.archive.org/web/20180621123605/http://fishing.shimano.co.jp:80/product/rod/5370","src_label":"시마노 공식 페이지(2018년 보관본)"},{"id":205,"note":"파워 계열 올라운드 베이트 모델이에요. 수심 10~60m+α에서 걸기(챔질) 중시, 빠르고 적극적인 유인에 맞춰졌어요.","specs":[["길이","1.98m (6'6\")"],["절수","2절"],["무게","90g"],["스테","8~25호 / 30~90g"],["라인","PE 0.4~1호"]],"src":"https://web.archive.org/web/20220705063611/https://fish.shimano.com/ja-JP/product/rod/egisutte/metalsutte/a075f000032yok4qae.html","src_label":"시마노 공식 페이지(2022년 보관본)"},{"id":206,"note":"참고 수심 ~40m, 다루기 쉬운 길이와 섬세함을 중시한 모델이에요. 조류·바람이 약할 때 스테이 등으로 예민한 오징어를 테크니컬하게 유인할 수 있어요.","specs":[["길이","1.98m"],["절수","2절"],["무게","85g"],["에기","MAX60g"],["라인","PE 0.4~1호"]],"src":"https://web.archive.org/web/20190802052907/http://fishing.shimano.co.jp/product/rod/5834","src_label":"시마노 공식 페이지(2019년 보관본)"},{"id":207,"note":"참고 수심 ~50m, 에기 MAX80g까지 쓰는 파워 계열이에요. 빠른 조작이 가능해 적극적인 유인으로 넓은 범위의 활성 높은 오징어를 모으기 좋아요.","specs":[["길이","1.98m"],["절수","2절"],["무게","87g"],["에기","MAX80g"],["라인","PE 0.4~1호"]],"src":"https://web.archive.org/web/20190802052907/http://fishing.shimano.co.jp/product/rod/5834","src_label":"시마노 공식 페이지(2019년 보관본)"},{"id":208,"note":"소프튜브 톱을 단 모델로, 경쾌한 조작성과 다양한 저킹에 맞춰졌어요. 기준 길이 8'6\"보다 4인치 짧은 설정이라고 소개돼요.","specs":[["길이","2.49m"],["절수","2절"],["무게","102g"],["에기","1.8~3.8호"],["라인","PE 0.4~1호"]],"src":"https://web.archive.org/web/20200817062055/http://fishing.shimano.co.jp/product/rod/6120","src_label":"시마노 공식 페이지(2020년 보관본)"},{"id":209,"note":"소프튜브 톱을 단, 다양한 상황에서 쓰는 올라운더 모델이에요. 라인업 중 사용 빈도가 높은 정석 모델로 소개돼요.","specs":[["길이","2.59m"],["절수","2절"],["무게","104g"],["에기","1.8~3.8호"],["라인","PE 0.4~1호"]],"src":"https://web.archive.org/web/20200817062055/http://fishing.shimano.co.jp/product/rod/6120","src_label":"시마노 공식 페이지(2020년 보관본)"},{"id":210,"note":"날카로운 에기 액션, 조류가 빠른 곳·깊은 곳 공략, 대형 노리기에 맞춘 모델이에요. 4호 에기도 확실히 조작할 수 있다고 소개돼요.","specs":[["길이","2.59m"],["절수","2절"],["무게","107g"],["에기","2~4호"],["라인","PE 0.5~1호"]],"src":"https://web.archive.org/web/20200817062055/http://fishing.shimano.co.jp/product/rod/6120","src_label":"시마노 공식 페이지(2020년 보관본)"},{"id":211,"note":"표준 길이 6'8\"의 올라운드 모델(R=레귤러 테이퍼)이에요. 팁의 섬세함과 버트 파워를 고루 갖췄고, 참고 수심은 20~50m+α예요.","specs":[["길이","2.03m (6'8\")"],["절수","2절"],["무게","87g"],["에기","MAX60g"],["라인","PE 0.4~1호"]],"src":"https://web.archive.org/web/20220719125201/https://fish.shimano.com/ja-JP/product/rod/egisutte/tipeging/a075f00003e2jmcqay.html","src_label":"시마노 공식 페이지(2022년 보관본)"},{"id":212,"note":"빠르고 적극적인 유인에 맞춘 모델로, 바람·파도가 강할 때도 에기 자세를 안정시키기 쉬운 7'0\" 길이예요.","specs":[["길이","2.13m (7'0\")"],["절수","2절"],["무게","92g"],["에기","MAX80g"],["라인","PE 0.4~1호"]],"src":"https://web.archive.org/web/20180621123605/http://fishing.shimano.co.jp:80/product/rod/5370","src_label":"시마노 공식 페이지(2018년 보관본)"},{"id":213,"note":"오모리그 대응 R(레귤러 테이퍼) 스피닝 모델이에요. 수심 20~100m+α에서 20~40호 봉돌을 쓰기 좋은 강도로 설정됐어요.","specs":[["길이","2.13m (7'0\")"],["절수","2절"],["무게","95g"],["스테","10~30호 / 40~110g"],["봉돌","20~40호 / 75~150g"],["라인","PE 0.4~1.2호"]],"src":"https://web.archive.org/web/20220430110449/https://fish.shimano.com/ja-JP/product/rod/egisutte/metalsutte/a075f00003e2g4fqaq.html","src_label":"시마노 공식 페이지(2022년 보관본)"},{"id":214,"note":"정석 메탈스테용 F(패스트 테이퍼) 베이트 모델이에요. 수심 10~80m+α, 섬세함과 파워를 고루 갖춘 파워 계열 올라운더예요.","specs":[["길이","1.98m (6'6\")"],["절수","2절"],["무게","90g"],["스테","8~25호 / 30~90g"],["라인","PE 0.4~1호"]],"src":"https://web.archive.org/web/20220430110449/https://fish.shimano.com/ja-JP/product/rod/egisutte/metalsutte/a075f00003e2g4fqaq.html","src_label":"시마노 공식 페이지(2022년 보관본)"},{"id":215,"note":"오모리그 대응 모델로 수심 20~100m+α, 20~40호 봉돌에 맞춘 강도예요. 팁은 줄 엉킴이 적은 LDB 가이드에 잘 보이는 흰 도장·빨간 스레드 솔리드예요.","specs":[["길이","2.13m (7'0\")"],["절수","2절"],["무게","101g"],["스테","10~30호 / 40~110g"],["봉돌","20~40호 / 75~150g"],["라인","PE 0.4~1.2호"]],"src":"https://web.archive.org/web/20220705063611/https://fish.shimano.com/ja-JP/product/rod/egisutte/metalsutte/a075f000032yok4qae.html","src_label":"시마노 공식 페이지(2022년 보관본)"},{"id":216,"note":"패스트 테이퍼의 정석 메탈스테 모델로 팁은 터프텍∞예요. 수심 0~60m+α, 조류가 느릴 때 자연스럽고 꼼꼼한 유인에 맞춘 태우기 중시 ML 파워예요.","specs":[["길이","1.98m"],["절수","3절 (변칙 3피스)"],["무게","87g"],["스테","5~20호 / 20~75g"],["라인","PE 0.4~1호"]],"src":"https://web.archive.org/web/20210418032611/http://fishing.shimano.co.jp/product/rod/6285","src_label":"시마노 공식 페이지(2021년 보관본)"},{"id":217,"note":"올라운드 스피닝 모델이에요. 수심 10~60m+α에서 쓰는 스피닝 올라운더로, 짧은 캐스팅으로 넓은 범위를 탐색하는 데 맞춰졌어요.","specs":[["길이","1.98m"],["절수","2절"],["무게","75g"],["스테","5~20호 / 20~75g"],["라인","PE 0.4~1호"]],"src":"https://web.archive.org/web/20190821134641/http://fishing.shimano.co.jp/product/rod/5347","src_label":"시마노 공식 페이지(2019년 보관본)"},{"id":218,"note":"풀솔리드 타이라바 모델로 수심 20~80m+α용이에요. 5'5\" 짧은 길이로 경쾌하게 다룰 수 있고, RIGHT는 오른손 감기 릴용이에요.","specs":[["길이","1.65m (5'5\")"],["절수","2절"],["무게","131g"],["헤드","버티컬 30~100g / 도테라 MAX150g"],["라인","PE MAX1호"]],"src":"https://web.archive.org/web/20210413071857/http://fishing.shimano.co.jp/product/rod/6290","src_label":"시마노 공식 페이지(2021년 보관본)"},{"id":219,"note":"풀솔리드 타이라바 모델로 수심 20~80m+α용이에요. 5'5\" 짧은 길이로 경쾌하게 다룰 수 있고, LEFT는 왼손 감기 릴용이에요.","specs":[["길이","1.65m (5'5\")"],["절수","2절"],["무게","131g"],["헤드","버티컬 30~100g / 도테라 MAX150g"],["라인","PE MAX1호"]],"src":"https://web.archive.org/web/20210413071857/http://fishing.shimano.co.jp/product/rod/6290","src_label":"시마노 공식 페이지(2021년 보관본)"},{"id":220,"note":"풀솔리드 시리즈 중 가장 부드러운 모델로, 저활성·조류가 느린 상황에 맞춰졌어요. 수심 20~80m+α용이고 LEFT는 왼손 감기 릴용이에요.","specs":[["길이","1.98m"],["절수","2절"],["무게","139g"],["헤드","버티컬 30~100g / 도테라 MAX150g"],["라인","PE MAX1호"]],"src":"https://web.archive.org/web/20210413071857/http://fishing.shimano.co.jp/product/rod/6290","src_label":"시마노 공식 페이지(2021년 보관본)"},{"id":221,"note":"풀솔리드 시리즈 중 가장 부드러운 모델로, 저활성·조류가 느린 상황에 맞춰졌어요. 수심 20~80m+α용이고 RIGHT는 오른손 감기 릴용이에요.","specs":[["길이","1.98m"],["절수","2절"],["무게","139g"],["헤드","버티컬 30~100g / 도테라 MAX150g"],["라인","PE MAX1호"]],"src":"https://web.archive.org/web/20210413071857/http://fishing.shimano.co.jp/product/rod/6290","src_label":"시마노 공식 페이지(2021년 보관본)"},{"id":222,"note":"풀솔리드 M 파워 모델로 수심 30~100m+α용이에요. 소형~대형 참돔 전반, 포인트·조류 변화가 많은 상황에 맞췄고 RIGHT는 오른손 감기 릴용이에요.","specs":[["길이","1.98m"],["절수","2절"],["무게","149g"],["헤드","버티컬 40~150g / 도테라 MAX200g"],["라인","PE MAX1.2호"]],"src":"https://web.archive.org/web/20210413071857/http://fishing.shimano.co.jp/product/rod/6290","src_label":"시마노 공식 페이지(2021년 보관본)"},{"id":223,"note":"솔리드 팁의 노세(태우기) 액션 스탠더드 모델로 범용성이 좋아요. 수심 20~80m+α용이고 RIGHT는 오른손 감기 릴용이에요.","specs":[["길이","2.08m"],["절수","2절"],["무게","136g"],["헤드","버티컬 30~100g / 도테라 MAX150g"],["라인","PE MAX1호"]],"src":"https://web.archive.org/web/20210413071857/http://fishing.shimano.co.jp/product/rod/6290","src_label":"시마노 공식 페이지(2021년 보관본)"},{"id":224,"note":"3GO 시리즈의 2절 캐스팅 로드예요. 공식 스펙표 기준 루어 최대 3/4oz, 라인 최대 16lb예요.","specs":[["길이","2.02m"],["절수","2절"],["무게","115g"],["루어","최대 3/4oz"],["라인","최대 16lb"]],"src":"http://www.kiganism.com/sub/product/brand/detail.php?it_id=1522151588","src_label":"기간이즘 공식 사이트"},{"id":225,"note":"3GO 시리즈의 2절 캐스팅 로드예요. 공식 스펙표 기준 루어 최대 1oz, 라인 최대 18lb예요.","specs":[["길이","2.00m"],["절수","2절"],["무게","122g"],["루어","최대 1oz"],["라인","최대 18lb"]],"src":"http://www.kiganism.com/sub/product/brand/detail.php?it_id=1522151588","src_label":"기간이즘 공식 사이트"},{"id":226,"note":"3GO 시리즈의 2절 캐스팅 로드예요. 공식 스펙표 기준 루어 최대 1 1/2oz, 라인 최대 20lb예요.","specs":[["길이","2.05m"],["절수","2절"],["무게","133g"],["루어","최대 1 1/2oz"],["라인","최대 20lb"]],"src":"http://www.kiganism.com/sub/product/brand/detail.php?it_id=1522151588","src_label":"기간이즘 공식 사이트"},{"id":227,"note":"경량 다운샷·네꼬·지그헤드 리그에 맞고, 5g 내외 스몰 러버지그까지 소화하는 스피닝 